# Database connection (e.g., Supabase pooled connection on port 6543 or local PostgreSQL)
# Example local format: postgresql://<user>:<password>@localhost:5432/<dbname>
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
# Direct database connection for migrations (port 5432)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
# Optional: set to false to skip automatic migrations on server boot (recommended if running migrations in Render build/pre-deploy command)
# AUTO_MIGRATE="true"

# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="replace_with_64_char_hex"
JWT_REFRESH_SECRET="replace_with_another_64_char_hex"

JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Password reset email via Resend (never commit a real API key)
RESEND_API_KEY="re_replace_with_resend_api_key"
RESEND_FROM="CorpHQ <no-reply@example.com>"

# Matrix COSEC Biometric Webhook secret token
MATRIX_WEBHOOK_SECRET="replace_with_secure_matrix_webhook_token"

NODE_ENV="development"
